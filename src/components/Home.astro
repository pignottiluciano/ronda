---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { messages, type Lang } from '../i18n/messages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const paths = { es: '/', en: '/en/' } as const;
const image = new URL(`/og-${lang}.png`, Astro.site);
const url = (l: Lang) => new URL(paths[l], Astro.site);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#faf6f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161311" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Before paint, to avoid a flash of the wrong theme. Key shared with src/scripts/theme.ts.
      try {
        const theme = localStorage.getItem('ronda.theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
      // Language: pages are / (es, the default) and /en/ (en). Only an explicit saved choice redirects.
      try {
        const saved = localStorage.getItem('ronda.lang');
        if ((saved === 'es' || saved === 'en') && saved !== document.documentElement.lang) {
          location.replace(saved === 'en' ? '/en/' : '/');
        }
      } catch {}
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('[data-lang]') : null;
        if (!link) return;
        try {
          localStorage.setItem('ronda.lang', link.dataset.lang);
        } catch {}
      });
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Ronda" />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-body" preload />
    <title>{t.pageTitle}</title>
    <link rel="canonical" href={url(lang)} />
    <link rel="alternate" hreflang="es" href={url('es')} />
    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="x-default" href={url('es')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ronda" />
    <meta property="og:title" content={t.pageTitle} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="page">
      <header class="top">
        <div class="brand">
          <svg viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
            <circle cx="16" cy="5" r="3.2" /><circle cx="25.5" cy="10.5" r="3.2" /><circle cx="25.5" cy="21.5" r="3.2" />
            <circle cx="16" cy="27" r="3.2" /><circle cx="6.5" cy="21.5" r="3.2" /><circle cx="6.5" cy="10.5" r="3.2" opacity="0.4" />
          </svg>
          <span>Ronda</span>
        </div>
        <p class="kicker">{t.kicker}</p>

        <nav class="lang" aria-label={t.langLabel}>
          <a href="/" lang="es" hreflang="es" data-lang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          <a href="/en/" lang="en" hreflang="en" data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </nav>

        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          popovertarget="theme-menu"
          aria-label={t.themeButton}
          data-current="system">
          <svg class="icon-system" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" />
          </svg>
          <svg class="icon-light" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="icon-dark" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
          </svg>
        </button>
        <div id="theme-menu" class="theme-menu" popover>
          <fieldset>
            <legend>{t.themeLegend}</legend>
            <label><input type="radio" name="theme" value="system" /> {t.themeSystem}</label>
            <label><input type="radio" name="theme" value="light" /> {t.themeLight}</label>
            <label><input type="radio" name="theme" value="dark" /> {t.themeDark}</label>
          </fieldset>
        </div>
      </header>

      <nav class="tabs" aria-label={t.listsLabel}>
        <div id="tabs" class="tabs-scroll">
          <button type="button" class="tab" aria-current="true">{t.defaultListName(1)}<small>0</small></button>
        </div>
        <button type="button" id="new-list" class="tab add">+ {t.newList}</button>
      </nav>

      <main class="layout">
        <section class="panel" aria-labelledby="list-name">
          <h1 class="sr-only">{t.titleStart}{t.titleEm}</h1>
          <div class="listname">
            <h2 id="list-name" class="list-title">{t.defaultListName(1)}</h2>
            <input id="list-name-input" class="list-title-input" maxlength="40" autocomplete="off" aria-label={t.listNameLabel} hidden />
            <div class="list-tools">
              <button type="button" id="rename" class="icon-btn" aria-label={t.renameList} title={t.renameList}>
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
              </button>
              <button type="button" id="delete" class="icon-btn" aria-label={t.deleteList} title={t.deleteList}>
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" /></svg>
              </button>
            </div>
          </div>
          <p class="lede">{t.lede}</p>

          <form id="draw-form" class="form" novalidate>
            <div class="field">
              <div class="field-head">
                <label class="label" for="person-input">{t.participantsLabel}</label>
                <span id="count" class="count" aria-live="polite">{t.participant(0)}</span>
              </div>
              <ul id="people" class="tagbox" role="list">
                <li class="person-new">
                  <input
                    id="person-input"
                    class="person-input"
                    type="text"
                    maxlength="40"
                    spellcheck="false"
                    autocomplete="off"
                    autocapitalize="words"
                    enterkeyhint="done"
                    aria-describedby="names-hint"
                    placeholder={t.personPlaceholder} />
                </li>
              </ul>
              <p id="names-hint" class="hint">{t.peopleHint}</p>
              <p id="saved" class="saved">{t.savedHere}</p>
            </div>

            <div class="field">
              <label class="label" for="groups">{t.groupsLabel}</label>
              <div class="stepper">
                <button type="button" data-step="-1" aria-label={t.groupsLess}>−</button>
                <input id="groups" type="number" inputmode="numeric" min="1" step="1" value="1" aria-describedby="groups-hint" />
                <button type="button" data-step="1" aria-label={t.groupsMore}>+</button>
              </div>
              <p id="groups-hint" class="hint">{t.groupsHint}</p>
            </div>

            <p id="error" class="error" aria-live="polite" hidden></p>

            <div class="actions">
              <button type="submit" class="btn btn-primary">{t.draw}</button>
              <button type="button" id="clear" class="btn btn-ghost">{t.clear}</button>
            </div>
          </form>
        </section>

        <section id="results" class="results" aria-labelledby="results-title">
          <div class="results-head">
            <h2 id="results-title">{t.results}</h2>
            <div id="result-actions" class="result-actions" hidden>
              <button type="button" id="again" class="btn btn-ghost">{t.again}</button>
              <button type="button" id="share" class="btn btn-ghost">{t.share}</button>
            </div>
          </div>
          <section id="timer" class="timer" data-status="idle" aria-labelledby="timer-title">
            <div class="timer-head">
              <h3 id="timer-title" class="timer-title">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8" /><path d="M12 9v4l2.5 2M9 2h6" /></svg>
                {t.timerLabel}
              </h3>
              <span id="timer-of" class="timer-of"></span>
            </div>
            <p id="timer-done" class="timer-done" hidden>{t.timerDone}</p>
            <p id="timer-time" class="timer-time" role="timer">30:00</p>
            <div id="timer-bar" class="timer-bar" aria-hidden="true" hidden><i></i></div>
            <div id="timer-setup" class="timer-setup">
              <div id="timer-presets" class="chips" role="group" aria-label={t.timerLabel}></div>
              <label class="timer-custom">
                {t.timerCustom}
                <input id="timer-custom" type="number" inputmode="numeric" min="1" max="180" step="1" aria-label={t.timerCustomLabel} />
                {t.timerUnit}
              </label>
            </div>
            <div class="timer-actions">
              <button type="button" id="timer-start" class="btn btn-primary">{t.timerStart}</button>
              <button type="button" id="timer-pause" class="btn btn-ghost" hidden>{t.timerPause}</button>
              <button type="button" id="timer-reset" class="btn btn-ghost" hidden>{t.timerReset}</button>
            </div>
            <p id="timer-announce" class="sr-only" aria-live="polite"></p>
          </section>
          <div id="output" class="output">
            <div class="empty">
              <svg viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
                <circle cx="16" cy="5" r="3.2" /><circle cx="25.5" cy="10.5" r="3.2" /><circle cx="25.5" cy="21.5" r="3.2" />
                <circle cx="16" cy="27" r="3.2" /><circle cx="6.5" cy="21.5" r="3.2" /><circle cx="6.5" cy="10.5" r="3.2" />
              </svg>
              <p>{t.empty}</p>
            </div>
          </div>
          <p id="status" class="status" aria-live="polite"></p>
        </section>
      </main>
    </div>

    <dialog id="delete-dialog" class="dialog" aria-labelledby="delete-title">
      <form method="dialog">
        <h2 id="delete-title"></h2>
        <p>{t.deleteBody}</p>
        <div class="dialog-actions">
          <button value="cancel" class="btn btn-ghost">{t.cancel}</button>
          <button value="delete" class="btn btn-danger">{t.confirmDelete}</button>
        </div>
      </form>
    </dialog>

    <script>
      import '../scripts/theme';
      import '../scripts/app';
      import '../scripts/timer';
      import '../scripts/pwa';
    </script>
  </body>
</html>
