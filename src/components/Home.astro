---
import Base from '../layouts/Base.astro';
import { ICONS } from '../lib/icons';
import { messages, type Lang } from '../i18n/messages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
---

<Base lang={lang} paths={{ es: '/', en: '/en/' }} title={t.pageTitle} description={t.description}>
  <nav class="tabs" aria-label={t.listsLabel}>
    <div id="tabs" class="tabs-scroll">
      <button type="button" class="tab" aria-current="true">{t.defaultListName(1)}<small>0</small></button>
    </div>
    <button type="button" id="new-list" class="tab add">+ {t.newList}</button>
  </nav>

  <main id="layout" class="layout" data-mode="draw">
    <section class="panel" aria-labelledby="list-name">
      <h1 class="sr-only">{t.titleStart}{t.titleEm}</h1>
      <div class="listname">
        <h2 id="list-name" class="list-title">{t.defaultListName(1)}</h2>
        <input id="list-name-input" class="list-title-input" maxlength="40" autocomplete="off" aria-label={t.listNameLabel} hidden />
        <div class="list-tools">
          <button type="button" id="turns-toggle" class="icon-btn" aria-pressed="false" aria-label={t.turnsToggle} title={t.turnsToggle}>
            <Fragment set:html={ICONS.clock} />
          </button>
          <button type="button" id="rename" class="icon-btn" aria-label={t.renameList} title={t.renameList}>
            <Fragment set:html={ICONS.pencil} />
          </button>
          <button type="button" id="delete" class="icon-btn" aria-label={t.deleteList} title={t.deleteList}>
            <Fragment set:html={ICONS.trash} />
          </button>
        </div>
      </div>
      <p class="lede">{t.lede}</p>

      <fieldset id="modes" class="seg" hidden>
        <legend class="sr-only">{t.modeLabel}</legend>
        <label><input type="radio" name="mode" value="draw" checked /><span>{t.modeDraw}</span></label>
        <label><input type="radio" name="mode" value="turns" /><span>{t.modeTurns}</span></label>
        <label><input type="radio" name="mode" value="ranking" /><span>{t.modeRanking}</span></label>
      </fieldset>

      <form id="draw-form" class="form" novalidate>
        <div class="field">
          <div class="field-head">
            <label class="label" for="person-input">{t.participantsLabel}</label>
            <span id="count" class="count" aria-live="polite">{t.participant(0)}</span>
          </div>
          <ul id="people" class="tagbox" role="list">
            <li class="person-new">
              <input
                id="person-input"
                class="person-input"
                type="text"
                maxlength="40"
                spellcheck="false"
                autocomplete="off"
                autocapitalize="words"
                enterkeyhint="done"
                aria-describedby="names-hint"
                placeholder={t.personPlaceholder} />
            </li>
          </ul>
          <p id="names-hint" class="hint">{t.peopleHint}</p>
          <p id="saved" class="saved">{t.savedHere}</p>
        </div>

        <div class="field draw-only">
          <label class="label" for="groups">{t.groupsLabel}</label>
          <div class="stepper">
            <button type="button" data-step="-1" aria-label={t.groupsLess}>−</button>
            <input id="groups" type="number" inputmode="numeric" min="1" step="1" value="1" aria-describedby="groups-hint" />
            <button type="button" data-step="1" aria-label={t.groupsMore}>+</button>
          </div>
          <p id="groups-hint" class="hint">{t.groupsHint}</p>
        </div>

        <p id="error" class="error draw-only" aria-live="polite" hidden></p>

        <div class="actions draw-only">
          <button type="submit" class="btn btn-primary">{t.draw}</button>
          <button type="button" id="clear" class="btn btn-ghost">{t.clear}</button>
        </div>
      </form>
    </section>

    <section id="results" class="results" aria-labelledby="results-title">
      <div class="results-head">
        <h2 id="results-title">{t.results}</h2>
        <div id="result-actions" class="result-actions" hidden>
          <button type="button" id="again" class="btn btn-ghost">{t.again}</button>
          <button type="button" id="share" class="btn btn-ghost">{t.share}</button>
        </div>
      </div>
      <div id="output" class="output">
        <div class="empty">
          <svg viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
            <circle cx="16" cy="5" r="3.2" /><circle cx="25.5" cy="10.5" r="3.2" /><circle cx="25.5" cy="21.5" r="3.2" />
            <circle cx="16" cy="27" r="3.2" /><circle cx="6.5" cy="21.5" r="3.2" /><circle cx="6.5" cy="10.5" r="3.2" />
          </svg>
          <p>{t.empty}</p>
        </div>
      </div>
      <p id="status" class="status"></p>
    </section>

    <section id="turns" class="turns turns-only" aria-labelledby="turns-title">
      <div class="results-head">
        <h2 id="turns-title">{t.turnsTitle}</h2>
        <span id="turns-total" class="count" hidden></span>
      </div>

      <div id="turns-setup" class="turns-setup">
        <div class="field">
          <span id="budget-label" class="label">{t.turnsBudgetLabel}</span>
          <div class="budget">
            <div id="budget-presets" class="chips" role="group" aria-labelledby="budget-label"></div>
            <label class="budget-custom">
              {t.turnsCustom}
              <input id="budget-custom" type="number" inputmode="numeric" min="1" max="60" step="1" aria-label={t.turnsCustomLabel(60)} />
              {t.turnsUnit}
            </label>
          </div>
        </div>
        <fieldset id="turn-order" class="field order-field">
          <legend class="label">{t.turnsOrderLabel}</legend>
          <div class="seg">
            <label><input type="radio" name="turn-order" value="draw" checked /><span>{t.turnsOrderDraw}</span></label>
            <label><input type="radio" name="turn-order" value="list" /><span>{t.turnsOrderList}</span></label>
          </div>
        </fieldset>
        <div id="queue" class="field" hidden>
          <div class="field-head">
            <span id="queue-title" class="label">{t.queueTitle}</span>
            <span id="queue-count" class="count"></span>
          </div>
          <ol id="queue-list" class="queue-list" aria-labelledby="queue-title"></ol>
        </div>
        <p id="turns-days" class="hint" hidden></p>
        <p class="hint"><span id="order-hint">{t.turnsHintDraw}</span> {t.turnsStartHint}</p>
        <div class="actions">
          <button type="button" id="turns-start" class="btn btn-primary">{t.turnsStart}</button>
        </div>
      </div>

      <div id="turns-live" class="turns-live" hidden>
        <div id="now" class="now" data-state="idle">
          <div class="now-head">
            <p id="now-label" class="now-label"></p>
            <button type="button" id="turns-float" class="btn btn-ghost btn-small" hidden>{t.floatOpen}</button>
          </div>
          <p id="now-name" class="now-name"></p>
          <p id="now-clock" class="now-clock" role="timer" aria-live="off">00:00</p>
          <p id="now-of" class="now-of"></p>
          <div id="now-bar" class="bar" aria-hidden="true"><i></i></div>
          <div class="now-controls">
            <button type="button" id="turns-pause" class="btn btn-clock" data-act="pause" aria-label={t.turnsPause} title={t.turnsPause} hidden>
              <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" /></svg>
              <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h4.5v16H6zM13.5 4H18v16h-4.5z" /></svg>
            </button>
            <button type="button" id="turns-next" class="btn btn-next"><span id="turns-next-label"></span></button>
          </div>
        </div>
        <div id="now-slot" class="now-slot" hidden>
          <p>{t.floatNote}</p>
          <button type="button" id="turns-unfloat" class="btn btn-ghost btn-small">{t.floatBack}</button>
        </div>
        <ul id="tiles" class="tiles" role="list"></ul>
        <div class="actions turns-end">
          <button type="button" id="turns-finish" class="btn btn-ghost btn-small">{t.turnsFinish}</button>
          <button type="button" id="turns-discard" class="btn btn-text btn-small">{t.turnsDiscard}</button>
        </div>
      </div>
      <p id="turns-announce" class="sr-only" aria-live="polite"></p>
    </section>

    <section id="ranking" class="ranking ranking-only" aria-labelledby="ranking-title">
      <div class="results-head">
        <h2 id="ranking-title">{t.rankTitle}</h2>
        <div class="result-actions">
          <button type="button" id="rank-copy" class="btn btn-ghost" hidden>{t.rankCopy}</button>
          <button type="button" id="rank-download" class="btn btn-ghost" hidden>{t.rankDownload}</button>
          <button type="button" id="rank-share" class="btn btn-ghost" hidden>{t.rankShare}</button>
        </div>
      </div>
      <p id="rank-empty" class="hint">{t.rankEmpty}</p>
      <div id="rank-body" class="rank-body" hidden>
        <p id="rank-meta" class="count"></p>
        <p class="hint">{t.rankHow}</p>
        <div id="podium" class="podium" aria-hidden="true"></div>
        <p id="rank-none" class="hint" hidden>{t.rankNoRows}</p>
        <table id="rank-table" class="rank-table">
          <caption class="sr-only">{t.rankTableLabel}</caption>
          <thead>
            <tr><th scope="col">{t.rankColPos}</th><th scope="col">{t.rankColPerson}</th><th scope="col">{t.rankColAvg}</th><th scope="col">{t.rankColDays}</th></tr>
          </thead>
          <tbody id="rank-rows"></tbody>
        </table>
        <div id="rank-few" class="rank-few" hidden>
          <h3>{t.rankFewTitle}</h3>
          <p id="rank-few-hint" class="hint"></p>
          <ul id="rank-few-list" class="few"></ul>
        </div>
        <div class="rank-history">
          <h3>{t.rankHistory}</h3>
          <ul id="history" class="history"></ul>
        </div>
      </div>
      <div class="rank-settings">
        <label class="budget-custom" for="min-days">
          {t.rankMinLabel}
          <input id="min-days" type="number" inputmode="numeric" min="1" max="99" step="1" />
        </label>
        <button type="button" id="rank-reset" class="btn btn-ghost" hidden>{t.rankReset}</button>
      </div>
    </section>
  </main>

  <section class="data" aria-labelledby="data-title">
    <h2 id="data-title">{t.backupTitle}</h2>
    <p class="hint">{t.backupHint}</p>
    <div class="actions">
      <button type="button" id="backup-export" class="btn btn-ghost">{t.backupExport}</button>
      <button type="button" id="backup-import" class="btn btn-ghost">{t.backupImport}</button>
      <input id="backup-file" type="file" accept="application/json,.json" hidden />
    </div>
  </section>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <Fragment slot="after">

    <dialog id="delete-dialog" class="dialog" aria-labelledby="delete-title">
      <form method="dialog">
        <h2 id="delete-title"></h2>
        <p>{t.deleteBody}</p>
        <div class="dialog-actions">
          <button value="cancel" class="btn btn-ghost">{t.cancel}</button>
          <button value="delete" class="btn btn-danger">{t.confirmDelete}</button>
        </div>
      </form>
    </dialog>

    <dialog id="confirm-dialog" class="dialog" aria-labelledby="confirm-title">
      <form method="dialog">
        <h2 id="confirm-title"></h2>
        <p id="confirm-body"></p>
        <div class="dialog-actions">
          <button value="cancel" class="btn btn-ghost">{t.cancel}</button>
          <button id="confirm-ok" value="ok" class="btn btn-danger"></button>
        </div>
      </form>
    </dialog>

    <script>
      import '../scripts/theme';
      import '../scripts/app';
      import '../scripts/pwa';
    </script>
  </Fragment>
</Base>
